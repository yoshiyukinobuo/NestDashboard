
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id        Int      @id @default(autoincrement())
  name      String
  status    String   @default("Planned")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
